      <aliases enabled='yes' />
      <column caption='Member %' datatype='real' default-format='p0.0%' name='[Calculation_1903006681329664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [member_casual] = &apos;member&apos; THEN [trip_id] END) / COUNT([trip_id])' />
      </column>
      <column caption='Casual %' datatype='real' default-format='p0.0%' name='[Calculation_1903006681776129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [member_casual] = &apos;casual&apos; THEN [trip_id] END) / COUNT([trip_id])' />
      </column>
